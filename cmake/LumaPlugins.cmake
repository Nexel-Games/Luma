# luma_add_plugin / luma_add_module — PLUGIN_ARCHITECTURE.md §10.3

function(luma_plugin_binaries_dir plugin_dir outVar)
    set(${outVar} "${plugin_dir}/Binaries/Win64" PARENT_SCOPE)
endfunction()

function(luma_add_module name)
    cmake_parse_arguments(MOD "" "PLUGIN;TYPE" "SOURCES;DEPENDS;PUBLIC_INCLUDE" ${ARGN})
    if(NOT MOD_PLUGIN)
        message(FATAL_ERROR "luma_add_module(${name}): PLUGIN is required")
    endif()
    if(NOT MOD_SOURCES)
        message(FATAL_ERROR "luma_add_module(${name}): SOURCES is required")
    endif()

    get_filename_component(_plugin_dir "${CMAKE_CURRENT_SOURCE_DIR}/../.." ABSOLUTE)
    if(NOT EXISTS "${_plugin_dir}")
        set(_plugin_dir "${CMAKE_SOURCE_DIR}/Plugins/${MOD_PLUGIN}")
    endif()

    add_library(${name} STATIC ${MOD_SOURCES})
    if(MOD_PUBLIC_INCLUDE)
        target_include_directories(${name} PUBLIC ${MOD_PUBLIC_INCLUDE})
    endif()
    if(MOD_DEPENDS)
        target_link_libraries(${name} PUBLIC ${MOD_DEPENDS})
    endif()
    if(NOT MOD_TYPE)
        set(MOD_TYPE Runtime)
    endif()
    set_target_properties(${name} PROPERTIES
        FOLDER "Plugins/${MOD_PLUGIN}"
        LUMA_MODULE_TYPE "${MOD_TYPE}"
        LUMA_MODULE_PLUGIN "${MOD_PLUGIN}")

    if(LUMA_MODULAR)
        add_library(${name}Dll SHARED ${MOD_SOURCES})
        if(MOD_PUBLIC_INCLUDE)
            target_include_directories(${name}Dll PUBLIC ${MOD_PUBLIC_INCLUDE})
        endif()
        if(MOD_DEPENDS)
            set(_dll_deps)
            foreach(_dep ${MOD_DEPENDS})
                if(TARGET ${_dep}Dll)
                    list(APPEND _dll_deps ${_dep}Dll)
                else()
                    list(APPEND _dll_deps ${_dep})
                endif()
            endforeach()
            target_link_libraries(${name}Dll PUBLIC ${_dll_deps})
        endif()
        luma_plugin_binaries_dir("${_plugin_dir}" _bin)
        set_target_properties(${name}Dll PROPERTIES
            FOLDER "Plugins/${MOD_PLUGIN}"
            OUTPUT_NAME "LumaEditor-${name}"
            RUNTIME_OUTPUT_DIRECTORY "${_bin}/$<CONFIG>"
            LIBRARY_OUTPUT_DIRECTORY "${_bin}/$<CONFIG>"
            ARCHIVE_OUTPUT_DIRECTORY "${_bin}/$<CONFIG>"
            WINDOWS_EXPORT_ALL_SYMBOLS ON)
        target_compile_definitions(${name}Dll PRIVATE LUMA_MODULE_DLL=1)
        luma_configure_modular(${name}Dll)
        set_target_properties(${name}Dll PROPERTIES
            LUMA_MODULE_TYPE "${MOD_TYPE}"
            LUMA_MODULE_PLUGIN "${MOD_PLUGIN}")
    endif()
endfunction()

function(luma_link_static_plugin host plugin)
    if(NOT TARGET ${host} OR NOT TARGET ${plugin})
        return()
    endif()
    target_link_libraries(${host} PRIVATE ${plugin})
    if(MSVC)
        target_link_options(${host} PRIVATE "/WHOLEARCHIVE:$<TARGET_FILE:${plugin}>")
    endif()
endfunction()

function(luma_module_is_game_runtime name outVar)
    if(NOT TARGET ${name})
        set(${outVar} FALSE PARENT_SCOPE)
        return()
    endif()
    get_property(_type TARGET ${name} PROPERTY LUMA_MODULE_TYPE)
    if(_type STREQUAL "Editor" OR _type STREQUAL "UncookedOnly")
        set(${outVar} FALSE PARENT_SCOPE)
    else()
        set(${outVar} TRUE PARENT_SCOPE)
    endif()
endfunction()

function(luma_plugin_link_hosts name)
    if(TARGET ${name})
        luma_module_is_game_runtime(${name} _game)
        if(_game)
            luma_link_static_plugin(LumaEngine ${name})
        endif()
        luma_link_static_plugin(LumaTests ${name})
        if(LUMA_MODULAR)
            if(TARGET ${name}Dll AND TARGET LumaEditor)
                add_dependencies(LumaEditor ${name}Dll)
            endif()
        else()
            luma_link_static_plugin(LumaEditor ${name})
        endif()
    endif()
    if(TARGET ${name}Editor)
        luma_link_static_plugin(LumaTests ${name}Editor)
        if(LUMA_MODULAR)
            if(TARGET ${name}EditorDll AND TARGET LumaEditor)
                add_dependencies(LumaEditor ${name}EditorDll)
            endif()
        else()
            luma_link_static_plugin(LumaEditor ${name}Editor)
        endif()
    endif()
endfunction()

function(luma_add_plugin name)
    cmake_parse_arguments(PLG "" "DIR" "" ${ARGN})
    if(PLG_DIR)
        set(_dir "${PLG_DIR}")
    else()
        set(_dir "${CMAKE_SOURCE_DIR}/Plugins/${name}")
    endif()
    if(NOT EXISTS "${_dir}/${name}.lplugin")
        message(FATAL_ERROR "luma_add_plugin(${name}): missing ${_dir}/${name}.lplugin")
    endif()
    option(LUMA_PLUGIN_${name} "Build plugin ${name}" ON)
    if(NOT LUMA_PLUGIN_${name})
        message(STATUS "Luma: plugin ${name} compiled out (LUMA_PLUGIN_${name}=OFF)")
        return()
    endif()
    add_subdirectory("${_dir}" "${CMAKE_BINARY_DIR}/Plugins/${name}")
    luma_validate_plugin_descriptor("${_dir}" ${name})
endfunction()

function(luma_validate_plugin_descriptor dir name)
    set(_file "${dir}/${name}.lplugin")
    file(READ "${_file}" _json)
    string(JSON _fv ERROR_VARIABLE _err GET "${_json}" FileVersion)
    if(_err OR NOT _fv EQUAL 1)
        message(FATAL_ERROR "${_file}: FileVersion 1 is required (got '${_fv}' ${_err})")
    endif()
    string(JSON _modType TYPE "${_json}" Modules)
    if(_modType STREQUAL "NOTFOUND")
        return()
    endif()
    if(NOT _modType STREQUAL "ARRAY")
        message(FATAL_ERROR "${_file}: Modules must be an array")
    endif()
    string(JSON _n LENGTH "${_json}" Modules)
    if(_n EQUAL 0)
        return()
    endif()
    math(EXPR _last "${_n} - 1")
    foreach(_i RANGE ${_last})
        string(JSON _modName GET "${_json}" Modules ${_i} Name)
        string(JSON _modKind GET "${_json}" Modules ${_i} Type)
        if(NOT TARGET ${_modName})
            message(FATAL_ERROR "${_file}: module '${_modName}' has no CMake target")
        endif()
        get_property(_built TARGET ${_modName} PROPERTY LUMA_MODULE_TYPE)
        if(_built AND NOT _built STREQUAL "${_modKind}")
            message(FATAL_ERROR
                "${_file}: module '${_modName}' Type '${_modKind}' does not match luma_add_module TYPE '${_built}'")
        endif()
    endforeach()
endfunction()

function(luma_assert_game_has_no_editor_modules)
    if(NOT TARGET LumaEngine)
        return()
    endif()
    get_target_property(_libs LumaEngine LINK_LIBRARIES)
    if(NOT _libs)
        set(_libs "")
    endif()
    set(_dump "")
    foreach(_lib ${_libs})
        string(APPEND _dump "${_lib}\n")
        if(TARGET "${_lib}")
            get_property(_type TARGET "${_lib}" PROPERTY LUMA_MODULE_TYPE)
            if(_type STREQUAL "Editor" OR _type STREQUAL "UncookedOnly")
                message(FATAL_ERROR
                    "LumaEngine links ${_type} module ${_lib}. Game targets may only static-link Runtime (and Developer) modules.")
            endif()
        endif()
    endforeach()
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated")
    file(WRITE "${CMAKE_BINARY_DIR}/generated/LumaEngineLinkLibraries.txt" "${_dump}")
endfunction()

