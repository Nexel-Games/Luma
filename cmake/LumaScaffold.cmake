# Copy a wizard template with the same {{tokens}} PluginWizard.cpp substitutes.

function(luma_scaffold_plugin template dest name)
    cmake_parse_arguments(SC "" "FRIENDLY;AUTHOR;DESCRIPTION;CATEGORY;ENGINE_VERSION" "" ${ARGN})
    if(NOT SC_FRIENDLY)
        set(SC_FRIENDLY "${name}")
    endif()
    if(NOT SC_AUTHOR)
        set(SC_AUTHOR "Luma")
    endif()
    if(NOT SC_DESCRIPTION)
        set(SC_DESCRIPTION "Wizard fixture")
    endif()
    if(NOT SC_CATEGORY)
        set(SC_CATEGORY "Tests")
    endif()
    if(NOT SC_ENGINE_VERSION)
        set(SC_ENGINE_VERSION ">=${PROJECT_VERSION} <1.0.0")
    endif()
    set(_src "${CMAKE_SOURCE_DIR}/Engine/Plugins/Templates/${template}")
    if(NOT EXISTS "${_src}")
        message(FATAL_ERROR "luma_scaffold_plugin: missing ${_src}")
    endif()
    file(GLOB_RECURSE _files RELATIVE "${_src}" "${_src}/*")
    foreach(_rel ${_files})
        if(_rel MATCHES "\\.keep$")
            # keep empty content dirs
        endif()
        set(_out_rel "${_rel}")
        string(REPLACE "{{PluginName}}" "${name}" _out_rel "${_out_rel}")
        string(REPLACE "{{EditorModuleName}}" "${name}Editor" _out_rel "${_out_rel}")
        set(_in "${_src}/${_rel}")
        set(_out "${dest}/${_out_rel}")
        file(READ "${_in}" _body)
        string(REPLACE "{{PluginName}}" "${name}" _body "${_body}")
        string(REPLACE "{{EditorModuleName}}" "${name}Editor" _body "${_body}")
        string(REPLACE "{{FriendlyName}}" "${SC_FRIENDLY}" _body "${_body}")
        string(REPLACE "{{Author}}" "${SC_AUTHOR}" _body "${_body}")
        string(REPLACE "{{Description}}" "${SC_DESCRIPTION}" _body "${_body}")
        string(REPLACE "{{Category}}" "${SC_CATEGORY}" _body "${_body}")
        string(REPLACE "{{EngineVersion}}" "${SC_ENGINE_VERSION}" _body "${_body}")
        get_filename_component(_parent "${_out}" DIRECTORY)
        file(MAKE_DIRECTORY "${_parent}")
        file(WRITE "${_out}" "${_body}")
    endforeach()
endfunction()
