#version 450
#extension GL_GOOGLE_include_directive : require

// Sky light capture, step 1: render the physical atmosphere into mip 0 of the
// source cubemap (one invocation per texel, z = cube face).

#include "sky_atmosphere.glsl"
#include "skylight_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CaptureUBO {
    AtmosphereParams atmo;
    vec4 camPos;  // capture position (only its altitude matters for the sky)
} u;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2DArray outMip;

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= uint(pc.size) || id.y >= uint(pc.size)) return;
    vec3 dir = TexelDirection(id, pc.size);

    // No sun disk: the sun already lights the scene analytically (with
    // shadows); capturing it too would double its specular reflection.
    AtmosphereParams p = u.atmo;
    p.sunDisk.y = 0.0;
    // Physical radiance only: Environment `exposure` (ozoneSky.w) is a display
    // brightening for the visible sky background. Folding it into the light
    // inflated the sky:sun ratio ~2.4x (measured ~1:2.2 vs a real clear day's
    // ~1:5-8), giving saturated blue shadows. `skyIntensity` (ozoneSky.y)
    // scales the sky's actual radiance and *does* reach the lighting.
    p.ozoneSky.w = 1.0;
    vec3 radiance = RenderSkyRadiance(u.camPos.xyz + dir * 1000.0, u.camPos.xyz, p);
    imageStore(outMip, ivec3(id), vec4(max(radiance, vec3(0.0)), 1.0));
}
